    {
      "name": "T04 | Dashboard with altered signature",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{modified_token}}"
          }
        ],
        "url": "{{base_url}}/identity/api/v2/user/dashboard",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const parts = pm.collectionVariables.get('token_a').split('.');",
              "parts[2] = (parts[2][0] === 'A' ? 'B' : 'A') + parts[2].slice(1);",
              "pm.collectionVariables.set('modified_token', parts.join('.'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('SECURITY: denied without token or protected data', function () {",
              "  pm.expect([401,403]).to.include(pm.response.code);",
              "  let b = {}; try { b = pm.response.json(); } catch (_) {}",
              "  pm.expect(Boolean(b.token || b.email || b.vehicleLocation)).to.equal(false);",
              "});"
            ]
          }
        }
      ]
    },
