          "raw": "{\"email\":\"{{user_a_email}}\",\"password\":\"{{lab_password}}\",\"name\":\"Lab A\",\"number\":\"7000000001\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PRECONDITION: new account created', () => {pm.expect(pm.response.code).to.equal(200);});"
            ]
          }
        }
      ]
    },
